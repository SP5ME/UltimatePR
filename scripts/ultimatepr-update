#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo "Updater wymaga uprawnień root." >&2; exit 1; }
CHANNEL=${1:-}
[ "$CHANNEL" = main ] || [ "$CHANNEL" = dev ] || { echo "Kanał musi być main albo dev." >&2; exit 2; }
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] && [ "${ULTIMATEPR_UPDATE_RUN:-0}" != 1 ]; then
  systemd-run --unit="ultimatepr-update-$(date +%s)" --collect --setenv=ULTIMATEPR_UPDATE_RUN=1 /usr/local/sbin/ultimatepr-update "$CHANNEL"
  echo "Aktualizacja została uruchomiona w oddzielnej usłudze systemowej."
  exit 0
fi
case "$(uname -m)" in x86_64|amd64) ARCH=amd64;; aarch64|arm64) ARCH=arm64;; armv7l|armv7) ARCH=armv7;; *) echo "Nieobsługiwana architektura." >&2; exit 3;; esac
TMP=$(mktemp -d /tmp/ultimatepr-update.XXXXXX); trap 'rm -rf "$TMP"' EXIT HUP INT TERM
if command -v curl >/dev/null 2>&1; then GET='curl -fsSL'; else GET='wget -qO-'; fi
API="https://api.github.com/repos/SP5ME/UltimatePR/releases/tags/$CHANNEL-latest"
PATTERN="ultimatepr-$CHANNEL-linux-$ARCH.tar.gz"
wait_for_systemd_stop() {
  i=0
  while [ "$i" -lt 15 ]; do
    systemctl is-active --quiet ultimatepr || return 0
    sleep 1
    i=$((i+1))
  done
  return 1
}
wait_for_openrc_stop() {
  i=0
  while [ "$i" -lt 15 ]; do
    rc-service ultimatepr status >/dev/null 2>&1 || return 0
    sleep 1
    i=$((i+1))
  done
  return 1
}
JSON=$($GET "$API")
URL=$(printf '%s' "$JSON" | tr ',' '\n' | sed -n 's/.*"browser_download_url":[[:space:]]*"\([^"]*\)".*/\1/p' | grep "$PATTERN" | head -n 1)
[ -n "$URL" ] || { echo "Nie znaleziono pakietu aktualizacji dla $ARCH." >&2; exit 4; }
case "$URL" in https://github.com/SP5ME/UltimatePR/releases/download/*) ;; *) echo "Odrzucono nieprawidłowy adres aktualizacji." >&2; exit 5;; esac
$GET "$URL" > "$TMP/package.tar.gz"
SUMURL=$(printf '%s' "$JSON" | tr ',' '\n' | sed -n 's/.*"browser_download_url":[[:space:]]*"\([^"]*SHA256SUMS.txt\)".*/\1/p' | head -n 1)
[ -n "$SUMURL" ] || { echo "Brak podpisanej listy sum SHA-256." >&2; exit 6; }
$GET "$SUMURL" > "$TMP/SHA256SUMS.txt"
EXPECTED=$(grep " $(basename "$URL")$" "$TMP/SHA256SUMS.txt" | awk '{print $1}')
ACTUAL=$(sha256sum "$TMP/package.tar.gz" | awk '{print $1}')
[ -n "$EXPECTED" ] && [ "$EXPECTED" = "$ACTUAL" ] || { echo "Suma SHA-256 pakietu jest nieprawidłowa." >&2; exit 6; }
tar -xzf "$TMP/package.tar.gz" -C "$TMP"
NEW=$(find "$TMP" -type f -name ultimatepr | head -n 1); [ -n "$NEW" ] || exit 7; chmod 0755 "$NEW"
cp -p /opt/ultimatepr/ultimatepr /var/lib/ultimatepr/backups/ultimatepr.previous
[ -f /etc/ultimatepr/config.yaml ] && cp -p /etc/ultimatepr/config.yaml "/var/lib/ultimatepr/backups/config-$(date +%Y%m%d-%H%M%S).yaml"
install -m 0755 "$NEW" /opt/ultimatepr/ultimatepr.new
mv /opt/ultimatepr/ultimatepr.new /opt/ultimatepr/ultimatepr
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  [ -f "$TMP/ultimatepr.service" ] && install -m 0644 "$TMP/ultimatepr.service" /etc/systemd/system/ultimatepr.service
  systemctl daemon-reload
  systemctl stop ultimatepr || true
  wait_for_systemd_stop || true
  systemctl reset-failed ultimatepr || true
  systemctl start ultimatepr
  i=0
  while [ "$i" -lt 15 ]; do
    systemctl is-active --quiet ultimatepr && break
    sleep 1
    i=$((i+1))
  done
  if ! systemctl is-active --quiet ultimatepr; then
    cp /var/lib/ultimatepr/backups/ultimatepr.previous /opt/ultimatepr/ultimatepr
    systemctl reset-failed ultimatepr || true
    systemctl stop ultimatepr || true
    wait_for_systemd_stop || true
    systemctl start ultimatepr
    i=0
    while [ "$i" -lt 15 ]; do
      systemctl is-active --quiet ultimatepr && break
      sleep 1
      i=$((i+1))
    done
    systemctl is-active --quiet ultimatepr || exit 8
  fi
else
  [ -f "$TMP/ultimatepr.openrc" ] && install -m 0755 "$TMP/ultimatepr.openrc" /etc/init.d/ultimatepr
  rc-service ultimatepr stop || true
  wait_for_openrc_stop || true
  rc-service ultimatepr start
  i=0
  while [ "$i" -lt 15 ]; do
    rc-service ultimatepr status >/dev/null 2>&1 && break
    sleep 1
    i=$((i+1))
  done
  if ! rc-service ultimatepr status >/dev/null 2>&1; then
    cp /var/lib/ultimatepr/backups/ultimatepr.previous /opt/ultimatepr/ultimatepr
    rc-service ultimatepr stop || true
    wait_for_openrc_stop || true
    rc-service ultimatepr start
    i=0
    while [ "$i" -lt 15 ]; do
      rc-service ultimatepr status >/dev/null 2>&1 && break
      sleep 1
      i=$((i+1))
    done
    rc-service ultimatepr status >/dev/null 2>&1 || exit 8
  fi
fi
echo "Aktualizacja UltimatePR zakończona."
